{
  "id": "photowall",
  "name": "Photo Wall",
  "kind": "app",
  "version": "0.1.1",
  "image": "ghcr.io/thezigpc/venuebox-photowall:0.1.1",
  "port": 3014,
  "sdk": { "version": "0.15.0", "level": 2 },
  "routes": {
    "player": "/",
    "table": "/tv",
    "host": "/host",
    "admin": "/admin"
  },
  "routing": { "basePath": true },
  "health": "/health",
  "events": ["x-photowall-approved"],
  "commands": [],
  "brandable": ["displayName", "tagline", "accent"],
  "resources": { "memory": "384m", "cpus": 1 },
  "network": { "internet": false },
  "env": { "DATA_DIR": "/data" }
}
